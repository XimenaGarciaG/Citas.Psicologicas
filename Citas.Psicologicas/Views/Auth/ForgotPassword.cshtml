@model Citas.Psicologicas.ViewModels.Auth.ForgotPasswordViewModel
@{
    Layout = "_LoginLayout";
}

<div class="login-page">
    <div class="login-banner">
        <div class="login-banner-logo">
            <i class="fa fa-key"></i>
        </div>
        <h1 class="login-banner-title">Recuperar<br>Contraseña</h1>
        <p class="login-banner-subtitle">
            Le enviaremos las instrucciones para restablecer el acceso a su cuenta institucional
        </p>
    </div>

    <div class="login-form-panel">
        <div class="login-form-header">
            <div class="uttt-badge">
                <i class="fa fa-university"></i> UTTT
            </div>
            <h2>Recuperación de acceso</h2>
            <p>Ingrese el correo institucional con el que se registró</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fa fa-exclamation-triangle"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ResetLink))
        {
            <div class="alert alert-success mb-4" role="alert">
                <i class="fa fa-check-circle me-2"></i>
                Si el correo existe, recibirá un enlace para restablecer su contraseña.
                <div class="mt-3 small">
                    <strong>Modo respaldo local (sin servicio de correo):</strong> utilice el siguiente enlace para continuar.
                    <a href="@Model.ResetLink" class="d-block mt-2 text-break">@Model.ResetLink</a>
                </div>
            </div>
        }
        else
        {
            <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="login-form">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label asp-for="Correo" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                        <input asp-for="Correo" class="form-control" placeholder="correo@uttt.edu.mx" autocomplete="email">
                    </div>
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fa fa-paper-plane me-1"></i>
                    <span>Enviar enlace</span>
                </button>
            </form>

            <div class="text-center mt-3">
                <a href="/Auth/Login" class="fw-600 text-primary text-decoration-none">
                    <i class="fa fa-arrow-left me-1"></i> Volver a iniciar sesión
                </a>
            </div>
        }

        <div class="login-footer-text">
            Universidad Tecnológica de Tula-Tepeji &copy; @DateTime.Now.Year
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
