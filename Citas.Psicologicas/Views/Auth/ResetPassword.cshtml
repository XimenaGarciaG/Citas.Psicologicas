@model Citas.Psicologicas.ViewModels.Auth.ResetPasswordViewModel
@{
    Layout = "_LoginLayout";
}

<div class="login-page">
    <div class="login-banner">
        <div class="login-banner-logo">
            <i class="fa fa-lock"></i>
        </div>
        <h1 class="login-banner-title">Nueva<br>Contraseña</h1>
        <p class="login-banner-subtitle">Establezca una nueva contraseña para su cuenta institucional</p>
    </div>

    <div class="login-form-panel">
        <div class="login-form-header">
            <div class="uttt-badge">
                <i class="fa fa-university"></i> UTTT
            </div>
            <h2>Restablecer contraseña</h2>
            <p>Complete los siguientes campos</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fa fa-exclamation-triangle"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="login-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token">

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                    <input asp-for="Correo" class="form-control" readonly>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock"></i></span>
                    <input asp-for="Password" class="form-control" autocomplete="new-password">
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock-check"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password">
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-login">
                <i class="fa fa-key me-1"></i>
                <span>Restablecer contraseña</span>
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="/Auth/Login" class="fw-600 text-primary text-decoration-none">
                <i class="fa fa-arrow-left me-1"></i> Volver a iniciar sesión
            </a>
        </div>

        <div class="login-footer-text">
            Universidad Tecnológica de Tula-Tepeji &copy; @DateTime.Now.Year
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
