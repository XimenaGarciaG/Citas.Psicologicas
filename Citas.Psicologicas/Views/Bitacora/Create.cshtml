@model Citas.Psicologicas.ViewModels.Bitacora.BitacoraCreateViewModel
@{
    ViewBag.PageTitle = "Registrar Asistencia";
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-book-open me-2"></i>Registrar Asistencia</h1>
            <p class="page-header-subtitle">Registre la asistencia de una cita en la bitácora administrativa</p>
        </div>
        <a href="/Bitacora" class="btn btn-light"><i class="fa fa-arrow-left me-1"></i> Regresar</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Registro de Asistencia</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        <strong>Nota:</strong> Las observaciones son de carácter administrativo únicamente.
                        No registre información clínica ni diagnósticos.
                    </div>

                    <div class="alert alert-info">
                        <i class="fa fa-clock me-2"></i>
                        Al enviar, el registro quedará <strong>pendiente de confirmación</strong> del estudiante.
                        Solo se registrará en la bitácora una vez que el estudiante lo confirme.
                    </div>

                    <form asp-controller="Bitacora" asp-action="Create" method="post" data-loading="Guardando registro...">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="IdCita" class="form-label">Cita</label>
                            <select asp-for="IdCita" class="form-select" id="selectCita" onchange="cargarDatosCita()">
                                <option value="">-- Seleccione una cita --</option>
                                @foreach (var c in Model.CitasSinRegistro)
                                {
                                    <option value="@c.Id"
                                            data-estudiante="@c.NombreEstudiante"
                                            data-psicologo="@c.NombrePsicologo"
                                            data-fecha="@c.Fecha.ToString("dd/MM/yyyy")">
                                        @c.NombreEstudiante – @c.Fecha.ToString("dd/MM/yyyy") @c.HoraInicio
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="IdCita" class="text-danger small"></span>
                        </div>

                        <div id="panelCita" class="mb-3 p-3 bg-light rounded" style="display:none">
                            <div class="row">
                                <div class="col-6"><strong>Estudiante:</strong> <span id="lblEstudiante"></span></div>
                                <div class="col-6"><strong>Psicólogo/a:</strong> <span id="lblPsicologo"></span></div>
                                <div class="col-6 mt-2"><strong>Fecha:</strong> <span id="lblFecha"></span></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">¿Asistió el estudiante?</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input type="radio" name="Asistencia" value="true" id="rAsistioSi" class="form-check-input">
                                    <label for="rAsistioSi" class="form-check-label text-success fw-600"><i class="fa fa-check me-1"></i>Sí asistió</label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" name="Asistencia" value="false" id="rAsistioNo" class="form-check-input">
                                    <label for="rAsistioNo" class="form-check-label text-danger fw-600"><i class="fa fa-times me-1"></i>No asistió</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="AcuerdoSeguimiento" class="form-check-input" type="checkbox" id="chkSeguimiento">
                            <label asp-for="AcuerdoSeguimiento" class="form-check-label">¿Requiere cita de seguimiento?</label>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Observaciones" class="form-label"></label>
                            <textarea asp-for="Observaciones" class="form-control" rows="4"
                                      placeholder="Observaciones administrativas generales (no clínicas)"
                                      data-max-length="500" data-counter="charObs"></textarea>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Solo observaciones administrativas</span>
                                <span id="charObs" class="text-muted small">0/500</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Bitacora" class="btn btn-light px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fa fa-paper-plane me-1"></i> Enviar al estudiante
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    function cargarDatosCita() {
        const sel = document.getElementById('selectCita');
        const opt = sel.selectedOptions[0];
        const panel = document.getElementById('panelCita');
        if (sel.value) {
            document.getElementById('lblEstudiante').textContent = opt.dataset.estudiante;
            document.getElementById('lblPsicologo').textContent  = opt.dataset.psicologo;
            document.getElementById('lblFecha').textContent      = opt.dataset.fecha;
            panel.style.display = 'block';
        } else {
            panel.style.display = 'none';
        }
    }
    </script>
}
