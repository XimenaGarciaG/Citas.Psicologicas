@model Citas.Psicologicas.ViewModels.Bitacora.BitacoraIndexViewModel
@{
    ViewBag.PageTitle = "Bitácora";
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-book-open me-2"></i>Bitácora Personal de Asistencia</h1>
            <p class="page-header-subtitle">
                <span class="text-success fw-600">@Model.TotalAsistencias asistencias</span> &bull;
                <span class="text-danger fw-600">@Model.TotalInasistencias inasistencias</span>
            </p>
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm mb-4 d-flex align-items-center gap-3">
        <i class="fa fa-circle-info fs-3 text-info"></i>
        <div>
            <strong>Proceso Automatizado de Bitácora:</strong>
            Las bitácoras se generan y envían directamente desde el detalle de cada cita finalizada (<a href="/Citas" class="alert-link">Agenda de Citas</a>). Al presionar <em>"Enviar Bitácora por Email"</em>, el alumno recibe la notificación por correo y, al confirmar, se almacena síncronamente en su bitácora personal.
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <input type="text" name="busqueda" class="form-control" value="@Model.FiltroBusqueda" placeholder="Buscar estudiante o psicólogo">
                </div>
                <div class="col-md-3">
                    <input type="date" name="fecha" class="form-control" value="@Model.FiltroFecha?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                </div>
                <div class="col-md-2">
                    <a href="/Bitacora" class="btn btn-light w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.TotalPendientes > 0)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title">
                    <i class="fa fa-clock me-1"></i>Pendientes de confirmación del estudiante
                    <span class="badge bg-warning text-dark ms-2">@Model.TotalPendientes</span>
                </h2>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Psicólogo/a</th>
                            <th>Asistencia</th>
                            <th>Enviada</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pendientes)
                        {
                            <tr>
                                <td class="fw-600">@p.NombreEstudiante</td>
                                <td class="text-muted">@p.NombrePsicologo</td>
                                <td>
                                    <span class="badge-pill badge-@(p.Asistencia ? "confirmada" : "cancelada")">
                                        @(p.Asistencia ? "Asistió" : "No asistió")
                                    </span>
                                </td>
                                <td class="text-muted small">@p.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a href="/Citas/Details/@p.IdCita" class="btn btn-sm btn-outline-primary">
                                        <i class="fa fa-eye me-1"></i> Ver cita
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            @if (!Model.Registros.Any())
            {
                <div class="empty-state">
                    <i class="fa fa-book empty-state-icon"></i>
                    <div class="empty-state-title">Sin registros</div>
                    <p class="empty-state-text">No hay registros de asistencia con los filtros aplicados.</p>
                    <a href="/Citas" class="btn btn-primary"><i class="fa fa-calendar-check me-1"></i> Ir a Agenda de Citas</a>
                </div>
            }
            else
            {
                <table class="table-modern datatable w-100" data-order='[[5,"desc"]]'>
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Psicólogo/a</th>
                            <th>Fecha Cita</th>
                            <th>Asistencia</th>
                            <th>Seguimiento</th>
                            <th>Registro</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Registros)
                        {
                            <tr>
                                <td class="fw-600">@r.NombreEstudiante</td>
                                <td class="text-muted">@r.NombrePsicologo</td>
                                <td>@(r.FechaCita?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>
                                    <span class="badge-pill badge-@r.BadgeAsistencia">@r.TextoAsistencia</span>
                                </td>
                                <td>
                                    @if (r.RequiereSeguimiento)
                                    { <span class="badge bg-warning text-dark">Sí</span> }
                                    else { <span class="text-muted small">No</span> }
                                </td>
                                <td class="text-muted small">@(r.Fecha?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="text-muted small text-truncate-2" style="max-width:200px">
                                    @(r.ObservacionesAdministrativas ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
