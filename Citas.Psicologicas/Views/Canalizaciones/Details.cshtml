@model Citas.Psicologicas.DTOs.Canalizaciones.CanalizacionDto
@{
    ViewBag.PageTitle = "Detalle de Canalización";
    var vinculo = ViewBag.VinculoSolicitud as Citas.Psicologicas.Models.CanalizacionSolicitud;
}

<div class="animate-fade-up">
    <div class="page-header mb-4">
        <div>
            <h1 class="page-header-title"><i class="fa fa-share-nodes me-2"></i>Detalle de Canalización</h1>
            <p class="page-header-subtitle">Información registrada por el tutor académico</p>
        </div>
        <a href="/Canalizaciones" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-1"></i> Volver a la lista
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h2 class="card-title h5 mb-0"><i class="fa fa-info-circle me-2"></i>Datos de la Canalización</h2>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-600">Estudiante:</div>
                        <div class="col-sm-8 fw-bold">@Model.NombreEstudiante</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-600">Tutor asignado:</div>
                        <div class="col-sm-8">@Model.NombreTutor</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-600">Motivo de la canalización:</div>
                        <div class="col-sm-8">@Model.Motivo</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-600">Observaciones:</div>
                        <div class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "Sin observaciones" : Model.Observaciones)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-600">Estado:</div>
                        <div class="col-sm-8">
                            <span class="badge-pill badge-@Model.Estado?.ToLower()">@Model.Estado</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 text-muted fw-600">Fecha de canalización:</div>
                        <div class="col-sm-8">@(Model.FechaCanalizacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h2 class="card-title h5 mb-0"><i class="fa fa-link me-2"></i>Solicitud Vinculada</h2>
                </div>
                <div class="card-body">
                    @if (vinculo is not null)
                    {
                        <p class="text-muted small mb-3">Se generó automáticamente una solicitud de atención para la psicóloga encargada.</p>
                        <div class="d-grid">
                            <a href="/Solicitudes/Details/@vinculo.IdSolicitud" class="btn btn-primary">
                                <i class="fa fa-folder-open me-1"></i> Ver Solicitud #@vinculo.IdSolicitud
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <i class="fa fa-exclamation-triangle fs-3 mb-2 d-block"></i>
                            <p class="mb-0 small">No hay una solicitud de atención vinculada directamente.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
