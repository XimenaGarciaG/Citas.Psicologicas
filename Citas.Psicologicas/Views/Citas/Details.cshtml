@model Citas.Psicologicas.ViewModels.Citas.CitaDetalleViewModel
@{
    ViewBag.PageTitle = "Detalle de Cita";
    var rol = Context.Session.GetString("Rol") ?? "";
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-calendar-check me-2"></i>Detalle de Cita</h1>
        </div>
        <a href="/Citas" class="btn btn-light"><i class="fa fa-arrow-left me-1"></i> Regresar</a>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Información de la Cita</h2>
                    <span class="badge-pill badge-@Model.Cita.BadgeEstado">@Model.Cita.Estado</span>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Estudiante</dt>
                        <dd class="col-sm-8 fw-600">@Model.Cita.NombreEstudiante</dd>

                        <dt class="col-sm-4">Psicólogo/a</dt>
                        <dd class="col-sm-8">@Model.Cita.NombrePsicologo</dd>

                        <dt class="col-sm-4">Fecha</dt>
                        <dd class="col-sm-8">@Model.Cita.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX"))</dd>

                        <dt class="col-sm-4">Horario</dt>
                        <dd class="col-sm-8">@Model.Cita.HoraInicio &ndash; @Model.Cita.HoraFin</dd>

                        <dt class="col-sm-4">Prioridad</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Cita.Prioridad))
                            { <span class="badge-pill badge-@Model.Cita.Prioridad.ToLower()">@Model.Cita.Prioridad</span> }
                            else { <span class="text-muted">Sin asignar</span> }
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Cita.Motivo))
                        {
                            <dt class="col-sm-4">Motivo / Notas</dt>
                            <dd class="col-sm-8 text-muted">@Model.Cita.Motivo</dd>
                        }

                        <dt class="col-sm-4">Seguimiento</dt>
                        <dd class="col-sm-8">
                            @(Model.Cita.EsSeguimiento ? "Sí" : "No")
                        </dd>
                    </dl>

                    <!-- Acciones -->
                    @if (rol == Roles.Administrador || rol == Roles.Psicologo)
                    {
                        <hr>
                        <div class="d-flex gap-2 flex-wrap">
                            @if (Model.PuedeConfirmar)
                            {
                                <form asp-action="Confirmar" asp-route-id="@Model.Cita.Id" method="post" id="formConfirmar">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-success"
                                            onclick="confirmAction('formConfirmar', 'Confirmar cita', '¿Desea confirmar esta cita?', 'question', 'Confirmar', '#059669')">
                                        <i class="fa fa-check me-1"></i> Confirmar
                                    </button>
                                </form>
                            }
                            @if (Model.PuedeCancelar)
                            {
                                <form asp-action="Cancelar" asp-route-id="@Model.Cita.Id" method="post" id="formCancelar">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-danger"
                                            onclick="confirmAction('formCancelar', 'Cancelar cita', '¿Está seguro de cancelar esta cita?', 'warning', 'Cancelar cita', '#DC2626')">
                                        <i class="fa fa-ban me-1"></i> Cancelar
                                    </button>
                                </form>
                            }
                            @if (Model.PuedeReagendar)
                            {
                                <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalReagendar">
                                    <i class="fa fa-calendar-days me-1"></i> Reagendar
                                </button>
                            }
                        </div>
                    }

                    <!-- Acciones del estudiante -->
                    @if (rol == Roles.Estudiante)
                    {
                        <hr>
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            @if (Model.PuedeCancelarEstudiante)
                            {
                                <form asp-action="Cancelar" asp-route-id="@Model.Cita.Id" method="post" id="formCancelarEstudiante">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-outline-danger"
                                            onclick="confirmAction('formCancelarEstudiante', 'Cancelar cita', '¿Está seguro de cancelar su cita?', 'warning', 'Cancelar cita', '#DC2626')">
                                        <i class="fa fa-ban me-1"></i> Cancelar mi cita
                                    </button>
                                </form>
                            }

                            @if (Model.AsistenciaConfirmada)
                            {
                                <span class="badge-pill badge-confirmada">
                                    <i class="fa fa-check me-1"></i> Asistencia confirmada
                                    @(Model.FechaConfirmacion.HasValue ? $"el {Model.FechaConfirmacion.Value:dd/MM/yyyy HH:mm}" : "")
                                </span>
                            }
                            else if (Model.PuedeConfirmarAsistencia)
                            {
                                <form asp-action="ConfirmarAsistencia" asp-route-id="@Model.Cita.Id" method="post" id="formConfirmarAsistencia">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-success"
                                            onclick="confirmAction('formConfirmarAsistencia', 'Confirmar asistencia', '¿Desea confirmar que asistió a la sesión?', 'question', 'Sí, asistí', '#059669')">
                                        <i class="fa fa-user-check me-1"></i> Confirmar mi asistencia
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Panel informativo -->
        <div class="col-lg-5">

            <!-- Seguimiento de la sesión (psicóloga / admin) - Solo cuando el alumno confirme asistencia -->
            @if ((rol == Roles.Administrador || rol == Roles.Psicologo) && Model.AsistenciaConfirmada)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa fa-list-check me-1"></i>Seguimiento de la sesión</h2>
                    </div>
                    <div class="card-body">
                        <form asp-action="GuardarSeguimiento" asp-route-id="@Model.Cita.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label asp-for="NotasSesion" class="form-label"></label>
                                <textarea asp-for="NotasSesion" class="form-control" rows="4"
                                          placeholder="Anotaciones sobre la sesión y la situación del estudiante"></textarea>
                                <span asp-validation-for="NotasSesion" class="text-danger small"></span>
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="RequiereProximaCita" class="form-check-input" type="checkbox" id="chkProxima">
                                <label asp-for="RequiereProximaCita" class="form-check-label">¿Requiere próxima cita?</label>
                            </div>
                            <div class="mb-3" id="divFechaProxima" style="display:@(Model.RequiereProximaCita ? "block" : "none")">
                                <label asp-for="FechaProximaCita" class="form-label"></label>
                                <input asp-for="FechaProximaCita" class="form-control" type="date"
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa fa-save me-1"></i> Guardar seguimiento
                            </button>
                        </form>

                        @if (Model.Seguimiento is not null && Model.Seguimiento.Programado && Model.Seguimiento.FechaProgramada.HasValue)
                        {
                            <hr>
                            <form asp-action="AgendarProximaCita" asp-route-id="@Model.Cita.Id" method="post">
                                @Html.AntiForgeryToken()
                                <span class="badge-pill badge-confirmada mb-2 d-inline-block">
                                    Próxima cita: @Model.Seguimiento.FechaProgramada.Value.ToString("dd/MM/yyyy")
                                </span>
                                <button type="submit" class="btn btn-warning w-100 mt-2">
                                    <i class="fa fa-calendar-plus me-1"></i> Agendar próxima cita
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }

            <!-- Registrar y Enviar Bitácora al Alumno (psicóloga / admin) - Solo durante la sesión en curso -->
            @if ((rol == Roles.Administrador || rol == Roles.Psicologo) && Model.EsSesionEnCurso)
            {
                <div class="card mt-3">
                    <div class="card-header bg-light">
                        <h2 class="card-title h6 mb-0"><i class="fa fa-paper-plane me-1"></i>Enviar Bitácora al Alumno por Email</h2>
                    </div>
                    <div class="card-body">
                        @if (Model.BitacoraPendiente is not null)
                        {
                            @if (Model.BitacoraPendiente.Confirmada)
                            {
                                <div class="alert alert-success py-2 small mb-3">
                                    <i class="fa fa-check-circle me-1"></i> Bitácora confirmada por el alumno el @(Model.BitacoraPendiente.FechaConfirmacion?.ToString("dd/MM/yyyy HH:mm"))
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 small mb-3">
                                    <i class="fa fa-clock me-1"></i> Bitácora enviada el @(Model.BitacoraPendiente.FechaEnvio.ToString("dd/MM/yyyy HH:mm")) — Pendiente de confirmación por el estudiante.
                                </div>
                            }
                        }
                        <form asp-action="EnviarBitacora" asp-route-id="@Model.Cita.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-600">Asistencia del estudiante</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="asistencia" id="radAsistio" value="true" checked="@(Model.BitacoraPendiente?.Asistencia != false)">
                                        <label class="form-check-label text-success fw-600" for="radAsistio"><i class="fa fa-check me-1"></i> Asistió</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="asistencia" id="radNoAsistio" value="false" checked="@(Model.BitacoraPendiente?.Asistencia == false)">
                                        <label class="form-check-label text-danger fw-600" for="radNoAsistio"><i class="fa fa-xmark me-1"></i> No asistió</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-600">Observaciones para la Bitácora</label>
                                <textarea name="observaciones" class="form-control" rows="3" placeholder="Resumen o notas de asistencia...">@(Model.BitacoraPendiente?.Observaciones)</textarea>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="acuerdoSeguimiento" value="true" id="chkAcuerdo" checked="@(Model.BitacoraPendiente?.AcuerdoSeguimiento == true)">
                                <label class="form-check-label" for="chkAcuerdo">Acuerdo de seguimiento en sesión</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa fa-paper-plane me-1"></i> Enviar Bitácora al Alumno por Email
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Bitácora pendiente de confirmación (estudiante) -->
            @if (rol == Roles.Estudiante && Model.BitacoraPendiente is not null)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa fa-book-open me-1"></i>Bitácora por confirmar</h2>
                    </div>
                    <div class="card-body">
                        @if (!Model.BitacoraPendiente.Confirmada)
                        {
                            <p class="mb-2">
                                La psicóloga registró tu asistencia. Confírmala para que quede en la bitácora.
                            </p>
                            <div class="alert @(Model.BitacoraPendiente.Asistencia ? "alert-success" : "alert-danger") py-2">
                                <i class="fa @(Model.BitacoraPendiente.Asistencia ? "fa-check" : "fa-xmark") me-1"></i>
                                <strong>@(Model.BitacoraPendiente.Asistencia ? "Asististe" : "No asististe")</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.BitacoraPendiente.Observaciones))
                            {
                                <p class="text-muted small">Observaciones: @Model.BitacoraPendiente.Observaciones</p>
                            }
                            <form asp-action="ConfirmarBitacora" asp-route-id="@Model.Cita.Id" method="post" id="formConfirmarBitacora">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-success w-100"
                                        onclick="confirmAction('formConfirmarBitacora', 'Confirmar bitácora', '¿Confirma que este registro de asistencia es correcto?', 'question', 'Sí, confirmar', '#059669')">
                                    <i class="fa fa-user-check me-1"></i> Confirmar y registrar bitácora
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-success py-2">
                                <i class="fa fa-check me-1"></i> Bitácora confirmada
                                @(Model.BitacoraPendiente.FechaConfirmacion.HasValue
                                    ? $"el {Model.BitacoraPendiente.FechaConfirmacion.Value:dd/MM/yyyy HH:mm}"
                                    : "")
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Reagendar -->
<div class="modal fade" id="modalReagendar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-calendar-days me-2"></i>Reagendar Cita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reagendar" asp-route-id="@Model.Cita.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Nueva Fecha</label>
                            <input asp-for="NuevaFecha" type="date" class="form-control"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Nueva Hora de Inicio</label>
                            <input asp-for="NuevaHoraInicio" type="time" class="form-control">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Nueva Hora de Fin</label>
                            <input asp-for="NuevaHoraFin" type="time" class="form-control">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Motivo de reagenda (opcional)</label>
                            <textarea asp-for="MotivoReagenda" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fa fa-calendar-days me-1"></i> Confirmar Reagenda
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle fecha próxima en seguimiento
        var chkProxima = document.getElementById('chkProxima');
        var divFechaProxima = document.getElementById('divFechaProxima');
        if (chkProxima && divFechaProxima) {
            chkProxima.addEventListener('change', function () {
                divFechaProxima.style.display = this.checked ? 'block' : 'none';
            });
        }

    </script>
}
