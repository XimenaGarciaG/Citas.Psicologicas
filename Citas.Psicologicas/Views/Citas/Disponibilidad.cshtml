@model Citas.Psicologicas.ViewModels.Citas.DisponibilidadViewModel
@{
    ViewBag.PageTitle = "Disponibilidad";
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-calendar-days me-2"></i>Disponibilidad de Horarios</h1>
            <p class="page-header-subtitle">Seleccione un horario disponible para solicitar una cita de atención psicológica</p>
        </div>
        <a href="/Solicitudes" class="btn btn-light"><i class="fa fa-arrow-left me-1"></i> Regresar</a>
    </div>

    <!-- Selector de fecha -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Fecha</label>
                    <input type="date" name="fecha" class="form-control"
                           value="@Model.Fecha.ToString("yyyy-MM-dd")"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fa fa-search me-1"></i> Ver horarios</button>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="text-muted small">@Model.FechaLabel</span>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex gap-3 mb-3 small">
        <span><span class="badge-pill badge-confirmada">Libre</span> Disponible para solicitar</span>
        <span><span class="badge-pill badge-cancelada">Ocupado</span> Horario ya agendado (no modificable)</span>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                Horarios del día &bull;
                <span class="text-success fw-600">@Model.Disponibles disponibles</span> &bull;
                <span class="text-danger fw-600">@Model.Ocupados ocupados</span>
            </h2>
        </div>
        <div class="card-body">
            @if (!Model.Horarios.Any())
            {
                <div class="empty-state">
                    <i class="fa fa-clock empty-state-icon"></i>
                    <div class="empty-state-title">Sin horarios</div>
                    <p class="empty-state-text">No hay horarios definidos para este día. Consulte la configuración de atención.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var h in Model.Horarios)
                    {
                        if (h.Ocupado)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="p-3 border rounded-3 bg-light text-muted text-center" style="opacity:.8" title="@(h.EstadoOcupado)">
                                    <i class="fa fa-lock me-1"></i>
                                    <div class="fw-600">@h.HoraInicio – @h.HoraFin</div>
                                    <div class="small">Ocupado</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <a href="/Solicitudes/Create?horaInicio=@h.HoraInicio&horaFin=@h.HoraFin&fechaCita=@Model.Fecha.ToString("yyyy-MM-dd")"
                                   class="p-3 d-block border rounded-3 text-center text-decoration-none"
                                   style="border-color:#059669!important;background:#F0FDF4">
                                    <i class="fa fa-calendar-plus text-success me-1"></i>
                                    <div class="fw-600 text-dark">@h.HoraInicio – @h.HoraFin</div>
                                    <div class="small text-success">Solicitar cita</div>
                                </a>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>
