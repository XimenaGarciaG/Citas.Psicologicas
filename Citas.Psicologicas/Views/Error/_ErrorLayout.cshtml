@{
    var code = ViewBag.StatusCode ?? 500;
    var titulo = code == 404 ? "Página no encontrada" : code == 401 ? "No autorizado" : "Error del servidor";
    var mensaje = code == 404
        ? "La página que busca no existe o fue movida de ubicación."
        : code == 401
            ? "No tiene permisos para acceder a este recurso."
            : "Ocurrió un error inesperado. Intente nuevamente o contacte al administrador del sistema.";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@titulo | UTTT Citas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css">
    <style>
        body { background: #0F172A; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .error-card { background: white; border-radius: 20px; padding: 56px 48px; text-align: center; max-width: 480px; width: 90%; }
        .error-code { font-size: 6rem; font-weight: 900; line-height: 1;
            background: linear-gradient(135deg, #2563EB, #7C3AED);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    </style>
</head>
<body>
    <div class="error-card animate-fade-up">
        <div class="error-code">@code</div>
        <div class="mb-2" style="font-size:3rem;">
            @if (code == 404)
            { <i class="fa fa-compass text-warning"></i> }
            else if (code == 401)
            { <i class="fa fa-lock text-danger"></i> }
            else
            { <i class="fa fa-triangle-exclamation text-danger"></i> }
        </div>
        <h2 class="fw-700">@titulo</h2>
        <p class="text-muted mt-2">@mensaje</p>
        <a href="/Home/Index" class="btn btn-primary mt-4 px-4">
            <i class="fa fa-home me-2"></i> Volver al inicio
        </a>
    </div>
</body>
</html>
