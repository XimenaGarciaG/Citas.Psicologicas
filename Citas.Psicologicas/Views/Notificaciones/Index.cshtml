@model List<Citas.Psicologicas.Models.NotificacionRegistro>
@{
    ViewBag.PageTitle = "Notificaciones";
    var tipos = ViewBag.Tipos as string[] ?? Array.Empty<string>();
    var tipoSel = ViewBag.TipoSeleccionado as string;
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-bell me-2"></i>Notificaciones</h1>
            <p class="page-header-subtitle">Historial de notificaciones y correos generados por el sistema</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Notificaciones/Enviar" class="btn btn-primary">
                <i class="fa fa-paper-plane me-1"></i> Enviar notificación
            </a>
            <a href="/Notificaciones/MisNotificaciones" class="btn btn-light">
                <i class="fa fa-inbox me-1"></i> Mis notificaciones
            </a>
        </div>
    </div>

    <div class="mb-3">
        <ul class="nav nav-pills gap-2">
            <li class="nav-item">
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Notificaciones/MisNotificaciones") ? "" : "active")"
                   href="/Notificaciones"><i class="fa fa-history me-1"></i> Historial</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Notificaciones/MisNotificaciones") ? "active" : "")"
                   href="/Notificaciones/MisNotificaciones"><i class="fa fa-inbox me-1"></i> Mis notificaciones</a>
            </li>
        </ul>
    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <form method="get" class="d-flex gap-2 align-items-center">
                <label class="form-label mb-0 small fw-600">Tipo:</label>
                <select name="tipo" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t" selected="@(t == tipoSel)">@t</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title"><i class="fa fa-list me-1"></i>Historial</h2>
        </div>
        <div class="table-responsive">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="fa fa-bell-slash empty-state-icon"></i>
                    <div class="empty-state-title">Sin notificaciones</div>
                    <p class="empty-state-text">Aún no se han generado notificaciones.</p>
                </div>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Destinatario</th>
                            <th>Estudiante</th>
                            <th>Asunto</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var n in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@n.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge-pill badge-@n.Tipo.ToLower()">@n.Tipo</span></td>
                                <td>@n.CorreoDestinatario</td>
                                <td>@n.NombreEstudiante</td>
                                <td class="text-muted">@n.Asunto</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="popover" data-bs-placement="left"
                                            data-bs-title="Contenido" data-bs-content="@n.Cuerpo">
                                        <i class="fa fa-eye"></i> Ver
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
            new bootstrap.Popover(el);
        });
    </script>
}
