@model Citas.Psicologicas.ViewModels.Perfil.PerfilViewModel
@{
    ViewBag.PageTitle = "Mi Perfil";
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-user me-2"></i>Mi Perfil</h1>
            <p class="page-header-subtitle">Información personal de su cuenta</p>
        </div>
        <a href="/Perfil/CambiarContrasena" class="btn btn-warning">
            <i class="fa fa-key me-1"></i> Cambiar Contraseña
        </a>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body text-center py-4">
                    <div class="avatar mx-auto mb-3" style="width:96px;height:96px;font-size:2rem;background:linear-gradient(135deg,#2563EB,#7C3AED)">
                        @Model.Iniciales
                    </div>
                    <h3 class="mb-1">@Model.NombreCompleto</h3>
                    <p class="text-muted mb-2">@Model.Correo</p>
                    <span class="badge bg-primary">@Model.RolLabel</span>
                    <div class="mt-3">
                        <span class="badge-pill @(Model.Activo ? "badge-activo" : "badge-inactivo")">
                            @(Model.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Datos personales</h2>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Nombre completo</dt>
                        <dd class="col-sm-8">@Model.NombreCompleto</dd>

                        <dt class="col-sm-4">Correo institucional</dt>
                        <dd class="col-sm-8">@Model.Correo</dd>

                        <dt class="col-sm-4">Rol</dt>
                        <dd class="col-sm-8">@Model.RolLabel</dd>

                        @if (Model.Rol == "ESTUDIANTE")
                        {
                            <dt class="col-sm-4">Matrícula</dt>
                            <dd class="col-sm-8">@(Model.Matricula ?? "—")</dd>

                            <dt class="col-sm-4">Carrera</dt>
                            <dd class="col-sm-8">@(Model.Carrera ?? "—")</dd>

                            <dt class="col-sm-4">Cuatrimestre</dt>
                            <dd class="col-sm-8">@(Model.Cuatrimestre?.ToString() ?? "—")</dd>

                            <dt class="col-sm-4">Grupo</dt>
                            <dd class="col-sm-8">@(Model.Grupo ?? "—")</dd>

                            <dt class="col-sm-4">¿Alumno regular?</dt>
                            <dd class="col-sm-8">@(Model.EsRegular == true ? "Sí" : "No")</dd>
                        }
                        else if (Model.Rol == "TUTOR")
                        {
                            <dt class="col-sm-4">Departamento</dt>
                            <dd class="col-sm-8">@(Model.Departamento ?? "—")</dd>
                        }
                        else if (Model.Rol == "PSICOLOGO")
                        {
                            <dt class="col-sm-4">Cédula profesional</dt>
                            <dd class="col-sm-8">@(Model.CedulaProfesional ?? "—")</dd>
                        }

                        @if (Model.FechaCreacion.HasValue)
                        {
                            <dt class="col-sm-4">Fecha de registro</dt>
                            <dd class="col-sm-8">@Model.FechaCreacion.Value.ToString("dd/MM/yyyy")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
