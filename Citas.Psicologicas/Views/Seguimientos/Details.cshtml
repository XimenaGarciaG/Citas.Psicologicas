@model Citas.Psicologicas.Models.SeguimientoRegistro
@{
    ViewBag.PageTitle = "Detalle de Seguimiento";
    var rolSesion = Context.Session.GetString("Rol") ?? "";
}

<div class="animate-fade-up">
    <div class="page-header mb-4">
        <div>
            <h1 class="page-header-title"><i class="fa fa-list-check me-2"></i>Detalle de Seguimiento</h1>
            <p class="page-header-subtitle">Registro de seguimiento de la sesión psicológica</p>
        </div>
        <div class="d-flex gap-2">
            @if (rolSesion == Roles.Psicologo || rolSesion == Roles.Administrador)
            {
                <a href="/Seguimientos/Edit/@Model.Id" class="btn btn-primary">
                    <i class="fa fa-pencil me-1"></i> Editar
                </a>
            }
            <a href="/Seguimientos" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            <h2 class="card-title h5 mb-0"><i class="fa fa-user me-2"></i>Información del Registro</h2>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-sm-3 text-muted fw-600">Estudiante:</div>
                <div class="col-sm-9 fw-bold">@Model.NombreEstudiante</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted fw-600">Psicólogo/a a cargo:</div>
                <div class="col-sm-9">@Model.NombrePsicologo</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted fw-600">Motivo de la sesión:</div>
                <div class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Motivo) ? "—" : Model.Motivo)</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted fw-600">Notas de la sesión:</div>
                <div class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.Notas))
                    {
                        <div class="p-3 bg-light rounded border">@Model.Notas</div>
                    }
                    else
                    {
                        <span class="text-muted">Sin notas registradas</span>
                    }
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3 text-muted fw-600">Estado de programación:</div>
                <div class="col-sm-9">
                    @if (Model.Programado && Model.FechaProgramada.HasValue)
                    {
                        <span class="badge-pill badge-confirmada">Programado para @Model.FechaProgramada.Value.ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                        <span class="badge-pill badge-pendiente">Pendiente</span>
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-sm-3 text-muted fw-600">Fecha de registro:</div>
                <div class="col-sm-9 text-muted">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
    </div>
</div>
