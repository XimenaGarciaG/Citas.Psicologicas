@model Citas.Psicologicas.ViewModels.Seguimientos.SeguimientoIndexViewModel
@{
    ViewBag.PageTitle = "Seguimientos";
    var estado = Model.Estado;
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-list-check me-2"></i>Seguimientos</h1>
            <p class="page-header-subtitle">Seguimientos derivados de la bitácora y registros programados</p>
        </div>
        @{
            var rolSesion = Context.Session.GetString("Rol") ?? "";
        }
        @if (rolSesion == Roles.Psicologo || rolSesion == Roles.Administrador)
        {
            <a href="/Seguimientos/Create" class="btn btn-primary"><i class="fa fa-plus me-1"></i> Nuevo seguimiento</a>
        }
    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <form method="get" class="d-flex gap-2 align-items-center">
                <label class="form-label mb-0 small fw-600">Estado:</label>
                <select name="estado" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    <option value="Pendientes" selected="@(estado == "Pendientes")">Pendientes</option>
                    <option value="Programados" selected="@(estado == "Programados")">Programados</option>
                </select>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title"><i class="fa fa-list me-1"></i>Registros</h2>
        </div>
        <div class="table-responsive">
            @if (!Model.Seguimientos.Any())
            {
                <div class="empty-state">
                    <i class="fa fa-check-double empty-state-icon"></i>
                    <div class="empty-state-title">Sin seguimientos</div>
                    <p class="empty-state-text">No hay seguimientos registrados.</p>
                </div>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha registro</th>
                            <th>Estudiante</th>
                            <th>Próxima cita</th>
                            <th>Psicólogo/a</th>
                            <th>Motivo</th>
                            <th>Notas de la sesión anterior</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Seguimientos)
                        {
                            <tr>
                                <td class="text-nowrap">@s.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="fw-600">@s.NombreEstudiante</td>
                                <td class="text-nowrap">
                                    @if (s.FechaMostrar.HasValue)
                                    {
                                        <span class="badge-pill badge-confirmada">@s.FechaMostrar.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else { <span class="text-muted">Sin fecha</span> }
                                </td>
                                <td class="text-muted">@s.NombrePsicologo</td>
                                <td class="text-muted">@(s.Motivo ?? "—")</td>
                                <td class="text-muted small" style="max-width:260px">
                                    @if (!string.IsNullOrEmpty(s.Notas))
                                    { <span class="text-truncate-2" title="@s.Notas">@s.Notas</span> }
                                    else { <span>—</span> }
                                </td>
                                <td>
                                    @if (s.Programado && s.FechaProgramada is not null)
                                    {
                                        <span class="badge-pill badge-confirmada">Programado</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pill badge-pendiente">Pendiente</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a href="/Seguimientos/Details/@s.Seguimiento.Id" class="btn btn-sm btn-outline-primary me-1" title="Ver detalle">
                                        <i class="fa fa-eye"></i> Detalle
                                    </a>
                                    @if (rolSesion == Roles.Psicologo || rolSesion == Roles.Administrador)
                                    {
                                        <a href="/Seguimientos/Edit/@s.Seguimiento.Id" class="btn btn-sm btn-outline-secondary" title="Editar">
                                            <i class="fa fa-pencil"></i> Editar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
