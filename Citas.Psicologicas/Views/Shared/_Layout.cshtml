@using Citas.Psicologicas.Constants
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Sistema de Gestión de Citas Psicológicas - Universidad Tecnológica de Tula-Tepeji">
    <title>@(ViewBag.PageTitle != null ? ViewBag.PageTitle + " | UTTT Citas" : "UTTT Citas Psicológicas")</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="app-wrapper">
    <!-- ===================== SIDEBAR ===================== -->
    <nav id="sidebar" class="sidebar">
        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="fa fa-brain"></i>
            </div>
            <div class="sidebar-brand-text">
                <div class="brand-name">UTTT Citas</div>
                <div class="brand-sub">Psicología</div>
            </div>
        </div>

        <!-- Nav -->
        <div class="sidebar-nav">
            @{
                var rawRol = Context.Session.GetString("Rol") ?? "";
                var rol = rawRol.ToUpper();
                var rolLabel = Roles.GetLabel(rawRol);
                var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

                bool isAdmin = rol == Roles.Administrador || rol == "ADMINISTRADOR";
                bool isPsico = rol == Roles.Psicologo || rol == "PSICÓLOGO";
                bool isTutor = rol == Roles.Tutor;
                bool isEstud = rol == Roles.Estudiante;
            }

            <!-- Dashboard – Todos -->
            <div class="nav-section-title">Principal</div>
            <a href="/Home/Index" class="nav-item-link @(currentPath == "/home/index" || currentPath == "/" ? "active" : "")">
                <span class="nav-icon"><i class="fa fa-chart-pie"></i></span>
                <span class="nav-label">Dashboard</span>
            </a>

            @if (isAdmin || isPsico)
            {
                <div class="nav-section-title">Administración</div>
            }

            @if (isAdmin)
            {
                <a href="/Usuarios" class="nav-item-link @(currentPath.StartsWith("/usuarios") ? "active" : "")">
                    <span class="nav-icon"><i class="fa fa-users"></i></span>
                    <span class="nav-label">Usuarios</span>
                </a>
            }

            @if (isAdmin || isPsico || isEstud)
            {
                <div class="nav-section-title">Solicitudes</div>
                <a href="/Solicitudes" class="nav-item-link @(currentPath.StartsWith("/solicitudes") ? "active" : "")">
                    <span class="nav-icon"><i class="fa fa-file-medical"></i></span>
                    <span class="nav-label">Solicitudes</span>
                </a>
            }

            @if (isAdmin || isPsico || isTutor)
            {
                <a href="/Canalizaciones" class="nav-item-link @(currentPath.StartsWith("/canalizaciones") ? "active" : "")">
                    <span class="nav-icon"><i class="fa fa-share-nodes"></i></span>
                    <span class="nav-label">Canalizaciones</span>
                </a>
            }

            <div class="nav-section-title">Agenda</div>
            <a href="/Citas" class="nav-item-link @(currentPath.StartsWith("/citas") ? "active" : "")">
                <span class="nav-icon"><i class="fa fa-calendar-check"></i></span>
                <span class="nav-label">Citas</span>
            </a>

            @if (isAdmin || isPsico)
            {
                <div class="nav-section-title">Reportes</div>
                <a href="/Bitacora" class="nav-item-link @(currentPath.StartsWith("/bitacora") ? "active" : "")">
                    <span class="nav-icon"><i class="fa fa-book-open"></i></span>
                    <span class="nav-label">Bitácora</span>
                </a>
                <a href="/Reportes" class="nav-item-link @(currentPath.StartsWith("/reportes") ? "active" : "")">
                    <span class="nav-icon"><i class="fa fa-file-chart-column"></i></span>
                    <span class="nav-label">Reportes</span>
                </a>
            }
        </div>

        <!-- Footer del sidebar -->
        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-avatar">
                    @{
                        var nombre = Context.Session.GetString("NombreCompleto") ?? "US";
                        var iniciales = nombre.Length >= 2 ? $"{nombre[0]}{nombre.Split(' ').LastOrDefault()?[0]}" : nombre[..1];
                    }
                    @iniciales.ToUpper()
                </div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">@nombre</div>
                    <div class="sidebar-user-role">@rolLabel</div>
                </div>
            </div>
        </div>
    </nav>

    <!-- ===================== MAIN CONTENT ===================== -->
    <div id="mainContent" class="main-content">
        <!-- TOPBAR -->
        <header id="topbar" class="topbar">
            <div class="topbar-left">
                <button id="sidebarToggle" class="sidebar-toggle" title="Toggle Sidebar">
                    <i class="fa fa-bars"></i>
                </button>
                <button id="mobileSidebarToggle" class="sidebar-toggle d-lg-none" title="Menu">
                    <i class="fa fa-bars"></i>
                </button>
                <div>
                    <div class="page-title">@(ViewBag.PageTitle ?? "Dashboard")</div>
                    <nav class="breadcrumb-nav" aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/Home/Index"><i class="fa fa-home"></i></a></li>
                            @if (ViewBag.Breadcrumb is IEnumerable<(string Label, string Url)> breadcrumbs)
                            {
                                foreach (var (label, url) in breadcrumbs)
                                {
                                    <li class="breadcrumb-item"><a href="@url">@label</a></li>
                                }
                            }
                            <li class="breadcrumb-item active">@(ViewBag.PageTitle ?? "Dashboard")</li>
                        </ol>
                    </nav>
                </div>
            </div>
            <div class="topbar-right">
                <!-- Avatar y menú usuario -->
                <div class="dropdown">
                    <button class="btn btn-light btn-sm d-flex align-items-center gap-2 border"
                            type="button" data-bs-toggle="dropdown">
                        <div class="avatar avatar-sm">@iniciales.ToUpper()</div>
                        <span class="d-none d-sm-block fw-600">@nombre.Split(' ')[0]</span>
                        <i class="fa fa-chevron-down fa-xs"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                        <li>
                            <div class="px-3 py-2">
                                <div class="fw-600 text-dark">@nombre</div>
                                <div class="text-muted small">@Context.Session.GetString("Correo")</div>
                                <span class="badge bg-primary mt-1">@rolLabel</span>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fa fa-sign-out-alt me-2"></i> Cerrar sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- CONTENIDO -->
        <main class="page-content">
            @* Toasts de TempData *@
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-auto-hide d-flex align-items-center gap-2 mb-3">
                    <i class="fa fa-check-circle"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-auto-hide d-flex align-items-center gap-2 mb-3">
                    <i class="fa fa-times-circle"></i> @TempData["Error"]
                </div>
            }

            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="app-footer">
            <span>Universidad Tecnológica de Tula-Tepeji &copy; @DateTime.Now.Year</span>
            &nbsp;&bull;&nbsp;
            <span>Sistema de Gestión de Citas Psicológicas v1.0</span>
        </footer>
    </div>
</div>

<!-- Toast container -->
<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999"></div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/datatables-init.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
