@model Citas.Psicologicas.ViewModels.Solicitudes.SolicitudCreateViewModel
@{
    ViewBag.PageTitle = "Nueva Solicitud";
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-file-medical me-2"></i>Solicitar Atención Psicológica</h1>
            <p class="page-header-subtitle">Complete el formulario para enviar su solicitud de atención</p>
        </div>
        <a href="/Solicitudes" class="btn btn-light"><i class="fa fa-arrow-left me-1"></i> Regresar</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title"><i class="fa fa-heart-pulse me-2 text-primary"></i>Solicitud de Atención</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle me-2"></i>
                        <strong>Información:</strong> Su solicitud será revisada por el equipo de psicología.
                        No olvide que el comentario es completamente <strong>opcional</strong>.
                    </div>

                    <form asp-controller="Solicitudes" asp-action="Create" method="post" data-loading="Enviando solicitud...">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdEstudiante">

                        <div class="mb-4">
                            <label asp-for="Comentario" class="form-label"></label>
                            <textarea asp-for="Comentario" class="form-control" rows="5"
                                      placeholder="Puede escribir un comentario opcional sobre el motivo de su solicitud (máximo 500 caracteres)"
                                      data-max-length="500" data-counter="charCount"></textarea>
                            <div class="d-flex justify-content-between">
                                <span asp-validation-for="Comentario" class="text-danger small"></span>
                                <span id="charCount" class="text-muted small">0/500</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Solicitudes" class="btn btn-light px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fa fa-paper-plane me-1"></i> Enviar Solicitud
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
