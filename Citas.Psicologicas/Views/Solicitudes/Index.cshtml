@model Citas.Psicologicas.ViewModels.Solicitudes.SolicitudIndexViewModel
@{
    ViewBag.PageTitle = ViewBag.EsBandeja == true ? "Bandeja de Solicitudes" : "Solicitudes";
    var rol = Context.Session.GetString("Rol") ?? "";
    var esBandeja = ViewBag.EsBandeja == true;
    var mostrarGeneral = ViewBag.MostrarListadoGeneral != false;
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-file-medical me-2"></i>@(esBandeja ? "Bandeja de Solicitudes" : "Solicitudes de Atención")</h1>
            @if (mostrarGeneral)
            {
                <p class="page-header-subtitle">@Model.Total solicitud(es) &bull; @Model.Pendientes pendiente(s)</p>
            }
            else
            {
                <p class="page-header-subtitle">Solicitudes directas dirigidas a usted, pendientes de agendar.</p>
            }
        </div>
        @if (rol == Roles.Estudiante)
        {
            <a href="/Citas/Disponibilidad" class="btn btn-primary">
                <i class="fa fa-calendar-plus me-1"></i> Nueva Solicitud desde Disponibilidad
            </a>
        }
    </div>

    <!-- Filtros -->
    @if (mostrarGeneral)
    {
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <input type="text" name="busqueda" class="form-control" value="@Model.FiltroBusqueda" placeholder="🔍 Buscar por estudiante o comentario">
                    </div>
                    <div class="col-md-3">
                        <select name="estado" class="form-select">
                            <option value="">Todos los estados</option>
                            <option value="@EstadosSolicitud.Pendiente" selected="@(Model.FiltroEstado == EstadosSolicitud.Pendiente)">Pendiente</option>
                            <option value="@EstadosSolicitud.Agendada" selected="@(Model.FiltroEstado == EstadosSolicitud.Agendada)">Agendada</option>
                            <option value="@EstadosSolicitud.Atendida" selected="@(Model.FiltroEstado == EstadosSolicitud.Atendida)">Atendida</option>
                            <option value="@EstadosSolicitud.Cancelada" selected="@(Model.FiltroEstado == EstadosSolicitud.Cancelada)">Cancelada</option>
                        </select>
                    </div>
                    @if (rol != Roles.Estudiante)
                    {
                        <div class="col-md-3">
                            <select name="prioridad" class="form-select">
                                <option value="">Todas las prioridades</option>
                                <option value="@Prioridades.Alta" selected="@(Model.FiltroPrioridad == Prioridades.Alta)">Alta</option>
                                <option value="@Prioridades.Media" selected="@(Model.FiltroPrioridad == Prioridades.Media)">Media</option>
                                <option value="@Prioridades.Baja" selected="@(Model.FiltroPrioridad == Prioridades.Baja)">Baja</option>
                            </select>
                        </div>
                    }
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="fa fa-filter"></i> Filtrar</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Solicitudes directas del calendario (solo psicóloga / administrador) -->
    @if (ViewBag.SolicitudesCalendario is List<Citas.Psicologicas.Models.SolicitudCalendario> solicitudesCalendario && solicitudesCalendario.Any())
    {
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title"><i class="fa fa-calendar-check me-1 text-success"></i> Solicitudes directas del calendario</h2>
                <span class="badge-pill badge-confirmada">@solicitudesCalendario.Count pendiente(s)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Psicóloga asignada</th>
                                <th>Fecha y horario</th>
                                <th>Fecha de envío</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sc in solicitudesCalendario)
                            {
                                <tr>
                                    <td class="fw-600">@sc.NombreEstudiante</td>
                                    <td><i class="fa fa-user-doctor me-1 text-primary"></i>@sc.NombrePsicologo</td>
                                    <td>@sc.FechaCita.ToString("dd/MM/yyyy") &bull; @sc.HoraInicio – @sc.HoraFin</td>
                                    <td class="text-muted small">@sc.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            @if (rol == Roles.Psicologo || rol == Roles.Administrador)
                                            {
                                                <form method="post" asp-controller="Citas" asp-action="AsignarDirecta"
                                                      asp-route-idSolicitud="@sc.IdSolicitud" class="d-inline" id="formAsignar_@sc.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button"
                                                            class="btn btn-sm btn-primary"
                                                            data-bs-toggle="tooltip" title="Agendar la cita con la psicóloga y horario preseleccionados"
                                                            onclick="confirmAction('formAsignar_@sc.Id', 'Agendar cita', '¿Agendar la cita de @sc.NombreEstudiante con @sc.NombrePsicologo el @sc.FechaCita.ToString("dd/MM/yyyy") a las @sc.HoraInicio?', 'question', 'Agendar', '#2563EB')">
                                                        <i class="fa fa-calendar-plus me-1"></i> Agendar cita
                                                    </button>
                                                </form>
                                            }
                                            <form method="post" asp-action="MarcarAtendida" asp-route-id="@sc.Id" class="d-inline" id="formCal_@sc.Id">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="btn btn-sm btn-outline-success"
                                                        onclick="confirmAction('formCal_@sc.Id', 'Marcar atendida', '¿Marcar como atendida la solicitud de @sc.NombreEstudiante?', 'question', 'Marcar', '#059669')">
                                                    <i class="fa fa-check me-1"></i> Marcar atendida
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (mostrarGeneral)
    {
        <div class="card">
            <div class="card-body p-0">
                @if (!Model.Solicitudes.Any())
                {
                <div class="empty-state">
                    <i class="fa fa-file-circle-xmark empty-state-icon"></i>
                    <div class="empty-state-title">Sin solicitudes</div>
                    <p class="empty-state-text">No hay solicitudes con los filtros seleccionados.</p>
                    @if (rol == Roles.Estudiante)
                    {
                        <a href="/Citas/Disponibilidad" class="btn btn-primary">Nueva solicitud desde Disponibilidad</a>
                    }
                </div>
            }
            else
            {
                <table class="table-modern datatable w-100">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Comentario</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Prioridad</th>
                            @if (rol != Roles.Estudiante) { <th>Psicólogo</th> }
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Solicitudes)
                        {
                            <tr>
                                <td class="fw-600">@s.NombreEstudiante</td>
                                <td class="text-muted text-truncate-2" style="max-width:200px">@(s.Comentario ?? "—")</td>
                                <td class="text-muted small">@(s.FechaSolicitud?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td><span class="badge-pill badge-@s.BadgeEstado">@s.Estado</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(s.Prioridad))
                                    {
                                        <span class="badge-pill badge-@s.Prioridad.ToLower()">@s.Prioridad</span>
                                    }
                                    else { <span class="text-muted small">Sin asignar</span> }
                                </td>
                                @if (rol != Roles.Estudiante)
                                {
                                    <td class="text-muted small">@(s.NombrePsicologo ?? "—")</td>
                                }
                                <td>
                                    <a href="/Solicitudes/Details/@s.Id" class="btn btn-icon btn-light btn-sm"
                                       data-bs-toggle="tooltip" title="Ver detalle">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
        </div>
    }

    @if (esBandeja && !mostrarGeneral && !(ViewBag.SolicitudesCalendario is System.Collections.Generic.List<Citas.Psicologicas.Models.SolicitudCalendario> listaBandeja && listaBandeja.Any()))
    {
        <div class="card">
            <div class="card-body">
                <div class="empty-state">
                    <i class="fa fa-inbox empty-state-icon"></i>
                    <div class="empty-state-title">Sin solicitudes directas</div>
                    <p class="empty-state-text">No hay solicitudes directas pendientes dirigidas a usted.</p>
                </div>
            </div>
        </div>
    }
</div>
