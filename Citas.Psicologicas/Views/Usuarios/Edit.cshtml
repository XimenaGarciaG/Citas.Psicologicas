@model Citas.Psicologicas.ViewModels.Usuarios.UsuarioEditViewModel
@{
    ViewBag.PageTitle = "Editar Usuario";
}

<div class="animate-fade-up">
    <div class="page-header">
        <div>
            <h1 class="page-header-title"><i class="fa fa-user-pen me-2"></i>Editar Usuario</h1>
            <p class="page-header-subtitle">Modifique los datos del usuario &middot; Rol: <strong>@Model.Rol</strong></p>
        </div>
        <a href="/Usuarios" class="btn btn-light"><i class="fa fa-arrow-left me-1"></i> Regresar</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Datos del Usuario</h2>
                    <div>
                        <span class="badge bg-primary me-1">@Model.Rol</span>
                        <span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">@(Model.Activo ? "Activo" : "Inactivo")</span>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-controller="Usuarios" asp-action="Edit" asp-route-id="@Model.Id" method="post" data-loading="Guardando cambios...">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NombreCompleto" class="form-label"></label>
                                <input asp-for="NombreCompleto" class="form-control">
                                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Correo" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                    <input asp-for="Correo" class="form-control">
                                </div>
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>

                            @if (Model.Rol == Roles.Estudiante)
                            {
                                <div class="col-md-4">
                                    <label asp-for="Matricula" class="form-label"></label>
                                    <input asp-for="Matricula" class="form-control">
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Carrera" class="form-label"></label>
                                    <input asp-for="Carrera" class="form-control">
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Grupo" class="form-label"></label>
                                    <input asp-for="Grupo" class="form-control">
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Cuatrimestre" class="form-label"></label>
                                    <input asp-for="Cuatrimestre" type="number" min="1" max="11" class="form-control">
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <input asp-for="EsRegular" class="form-check-input" type="checkbox" role="switch" id="switchRegular">
                                        <label asp-for="EsRegular" class="form-check-label" for="switchRegular">¿Alumno regular?</label>
                                    </div>
                                </div>
                            }
                            else if (Model.Rol == Roles.Tutor)
                            {
                                <div class="col-md-6">
                                    <label asp-for="Departamento" class="form-label"></label>
                                    <input asp-for="Departamento" class="form-control">
                                </div>
                            }
                            else if (Model.Rol == Roles.Psicologo)
                            {
                                <div class="col-md-6">
                                    <label asp-for="CedulaProfesional" class="form-label"></label>
                                    <input asp-for="CedulaProfesional" class="form-control">
                                </div>
                            }
                        </div>

                        <hr class="my-4">
                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Usuarios" class="btn btn-light px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fa fa-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
